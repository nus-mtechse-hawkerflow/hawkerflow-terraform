# Copy to backend.tf (gitignored), then run: terraform init
#
# This is the state of the shared dev deployment, in AWS account 971586140094.
# Everyone working on that deployment must use this same bucket and key, with
# credentials for that account. Do not run "terraform apply" from a second
# state against the same account: it would try to create everything again.
#
# For a separate deployment in another account, create your own private,
# versioned S3 bucket and put its name here instead.
terraform {
  backend "s3" {
    bucket       = "hawkerflow-tf-state-971586140094-ap-southeast-1"
    key          = "hawkerflow/dev/terraform.tfstate"
    region       = "ap-southeast-1"
    use_lockfile = true
    encrypt      = true
  }
}
