# Copy to terraform.tfvars (gitignored). These are the values the shared dev
# deployment runs with.

aws_region   = "ap-southeast-1"
project_name = "hawkerflow"
environment  = "dev"

# services is deliberately not set here. The defaults in variables.tf match the
# real services: order, hawker, customer and analytics, each on port 8080, routed
# under /order, /hawker, /customer and /insights. Override it only to change
# sizing or image tags, and keep those keys, ports and route prefixes.

# Minutes a stall has to accept an order before the order service cancels it
order_pending_expiry_minutes = 15

# Frontend Angular Applications hosted on S3 + CloudFront
frontend_apps = {
  customer = {
    comment     = "Customer portal Angular web application"
    price_class = "PriceClass_100"
  }
  hawker = {
    comment     = "Hawker / Merchant portal Angular web application"
    price_class = "PriceClass_100"
  }
}

# Cognito User Pools
cognito_pools = {
  customer = {}
  hawker   = {}
}

# Allowed origins and headers for API Gateway CORS
cors_allow_origins = ["*"]
cors_allow_headers = ["*"]

# Bastion host for DBeaver / database access (No NAT Gateway needed)
enable_bastion              = true
bastion_instance_type       = "t4g.nano"    # lowest cost (~$0.0053/hr)
bastion_allowed_cidr_blocks = ["0.0.0.0/0"] # restrict to your IP (e.g. ["203.0.113.195/32"]) for tighter security
