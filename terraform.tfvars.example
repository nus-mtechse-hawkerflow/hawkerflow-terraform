aws_region   = "ap-southeast-1"
project_name = "hawkerflow"
environment  = "dev"

# Rename these keys to match your real services. The key becomes part of the
# ECR repository, ECS service and task-definition names.
services = {
  user = {
    container_port = 8000
    cpu            = 256
    memory         = 512
    desired_count  = 1
    route_prefix   = "/users"
    health_path    = "/health"
    image_tag      = "latest"
  }
  order = {
    container_port = 8000
    cpu            = 256
    memory         = 512
    desired_count  = 1
    route_prefix   = "/orders"
    health_path    = "/health"
    image_tag      = "latest"
  }
  hawker = {
    container_port = 8000
    cpu            = 256
    memory         = 512
    desired_count  = 1
    route_prefix   = "/hawkers"
    health_path    = "/health"
    image_tag      = "latest"
  }
  payment = {
    container_port = 8000
    cpu            = 256
    memory         = 512
    desired_count  = 1
    route_prefix   = "/payments"
    health_path    = "/health"
    image_tag      = "latest"
  }
}
